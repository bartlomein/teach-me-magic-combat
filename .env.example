# Optional: email anonymous report-card feedback to yourself (sent with Resend).
# Leave RESEND_API_KEY or FEEDBACK_TO unset and the "Did you enjoy it?" question is simply not shown.
RESEND_API_KEY=
FEEDBACK_TO=
# A sender on a domain verified in Resend. Without it, Resend's test sender is used,
# which only delivers to the email address of the Resend account itself.
FEEDBACK_FROM=
